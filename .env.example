# GCP project containing the Vertex AI usage you want to monitor
GCP_PROJECT_ID=your-project-id

# Optional: path to a service account key JSON file.
# Leave unset to use Application Default Credentials
# (`gcloud auth application-default login`).
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/sa-key.json

# Server bind config
HOST=127.0.0.1
PORT=8000
